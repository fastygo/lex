{
  "name": "lex-flow",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "ui8px:prepare": "bun scripts/ui8px-prepare.mjs",
    "lint:ui8px": "bun scripts/ui8px-prepare.mjs && ui8px lint .ui8px/scan src/assets/styles/styles.css",
    "validate:ui8px-aria": "bun scripts/ui8px-prepare.mjs && ui8px validate aria .ui8px/scan --package package.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^26.6.2",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "ui8px": "0.2.4",
    "vite": "^7.1.5"
  },
  "ui8kit": {
    "aria": {
      "mode": "subset",
      "patterns": [
        "dialog",
        "disclosure",
        "tooltip",
        "alert"
      ]
    }
  }
}
