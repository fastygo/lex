{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lex.fastygo.dev/schema/v0.1/replay-bundle",
  "title": "LeX v0.1 replay bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "verifier_version",
    "entity",
    "context",
    "question_set",
    "policy",
    "decision_set",
    "bundle_hash"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1-draft"
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "type", "schema_version", "version", "checksum"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "type": {"type": "string", "minLength": 1, "maxLength": 256},
        "schema_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "checksum": {"$ref": "#/$defs/sha256"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "snapshot", "pack_request", "pack_hash"],
      "properties": {
        "pack": {"type": "object"},
        "snapshot": {"type": "object"},
        "pack_request": {"type": "object"},
        "pack_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "question_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash", "questions"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "hash": {"$ref": "#/$defs/sha256"},
        "questions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "additionalProperties": {"$ref": "#/$defs/question"}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "decision_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_pack_hash",
        "question_set_hash",
        "policy_hash",
        "adapter_id",
        "adapter_version",
        "resolved_model",
        "answers"
      ],
      "properties": {
        "context_pack_hash": {"$ref": "#/$defs/sha256"},
        "question_set_hash": {"$ref": "#/$defs/sha256"},
        "policy_hash": {"$ref": "#/$defs/sha256"},
        "adapter_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "resolved_model": {"type": "string", "minLength": 1, "maxLength": 256},
        "answers": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "additionalProperties": {"$ref": "#/$defs/answer"}
        }
      }
    },
    "bundle_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instructions"],
      "properties": {
        "type": {"enum": ["noul", "choice", "score"]},
        "instructions": {"type": "string", "minLength": 1, "maxLength": 16384},
        "criteria": {}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["noul", "choice", "score"]}
      }
    }
  }
}
