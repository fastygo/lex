{
  "openapi": "3.1.1",
  "info": {
    "title": "LeX API",
    "version": "0.2",
    "summary": "Typed decisions over caller-owned State and QuestionSets, with caller-owned replay. Canary contract; not a conformance certification."
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {"description": "Process is serving."}
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "capabilities",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Supported operations. Decision follows adapter configuration. Execution is off.",
            "headers": {"Cache-Control": {"schema": {"const": "no-store"}}},
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/CapabilitiesResponse"}}
            }
          },
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "405": {"$ref": "#/components/responses/Problem"},
          "406": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "503": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/decisions": {
      "post": {
        "operationId": "decide",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "decision-request.schema.json"}}
          }
        },
        "responses": {
          "200": {
            "description": "A structurally valid caller-defined typed decision. This response has no semantic domain verdict. No Location and no 202 job.",
            "headers": {"Cache-Control": {"schema": {"const": "no-store"}}},
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/DecisionResponse"}}
            }
          },
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "405": {"$ref": "#/components/responses/Problem"},
          "406": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "415": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"},
          "499": {"$ref": "#/components/responses/Problem"},
          "500": {"$ref": "#/components/responses/Problem"},
          "502": {"$ref": "#/components/responses/Problem"},
          "503": {"$ref": "#/components/responses/Problem"},
          "504": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/replays": {
      "post": {
        "operationId": "replay",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "decision-bundle.schema.json"}}
          }
        },
        "responses": {
          "200": {
            "description": "Structural verification reproduced from the submitted bundle, including a reproduced invalid status.",
            "headers": {"Cache-Control": {"schema": {"const": "no-store"}}},
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/ReplayResponse"}}
            }
          },
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "405": {"$ref": "#/components/responses/Problem"},
          "406": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "415": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"},
          "499": {"$ref": "#/components/responses/Problem"},
          "500": {"$ref": "#/components/responses/Problem"},
          "503": {"$ref": "#/components/responses/Problem"},
          "504": {"$ref": "#/components/responses/Problem"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer"}
    },
    "responses": {
      "Problem": {
        "description": "RFC 9457 problem. The status member matches the HTTP status.",
        "content": {
          "application/problem+json": {
            "schema": {"$ref": "#/components/schemas/Problem"},
            "example": {
              "type": "https://lex.fastygo.dev/problems/authentication_required",
              "title": "Unauthorized",
              "status": 401,
              "detail": "a bearer token is required",
              "reason": "authentication_required"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "status", "detail", "reason"],
        "properties": {
          "type": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "integer"},
          "detail": {"type": "string"},
          "reason": {"type": "string", "enum": [
            "admission_limited",
            "authentication_denied",
            "authentication_required",
            "body_too_large",
            "client_canceled",
            "deadline_exceeded",
            "decision_error",
            "decision_provider_unavailable",
            "invalid_body",
            "invalid_json",
            "invalid_replay_bundle",
            "internal_error",
            "json_too_deep",
            "method_not_allowed",
            "not_acceptable",
            "not_found",
            "pack_error",
            "project_forbidden",
            "provider_unavailable",
            "question_error",
            "response_budget",
            "unsupported_media_type",
            "verification_error"
          ]},
          "structural_status": {"const": "invalid"},
          "findings": {"type": "array", "items": {"$ref": "#/components/schemas/Finding"}},
          "trace": {"type": "array", "items": {"$ref": "#/components/schemas/TraceStage"}},
          "replay_bundle": {"type": "object"},
          "adapter_metadata": {"$ref": "#/components/schemas/AdapterMetadata"}
        }
      },
      "CapabilitiesResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol_status", "protocol_version", "operations", "typed_decision", "context", "limits", "retention"],
        "properties": {
          "protocol_status": {"const": "canary"},
          "protocol_version": {"const": "0.2"},
          "operations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision", "replay", "execution"],
            "properties": {
              "decision": {"type": "boolean"},
              "replay": {"const": true},
              "execution": {"const": false}
            }
          },
          "typed_decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primitives", "max_questions", "max_choice_options", "max_score_levels", "adapter_contract", "resolved_model_policy", "semantic_verdict"],
            "properties": {
              "primitives": {"type": "array", "items": {"enum": ["noul", "choice", "score"]}, "minItems": 3, "maxItems": 3, "uniqueItems": true},
              "max_questions": {"const": 64},
              "max_choice_options": {"const": 255},
              "max_score_levels": {"const": 10},
              "adapter_contract": {"const": "0.1.0"},
              "resolved_model_policy": {"const": "exact_pin"},
              "semantic_verdict": {"const": false}
            }
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["binding", "runtime", "verification"],
            "properties": {
              "binding": {"const": "optional"},
              "runtime": {"const": "memory-exact-v1"},
              "verification": {"const": "rebuild"}
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "description": "process_admission is the maximum number of requests running in this process, not a global quota.",
            "required": ["max_body_bytes", "max_context_bytes", "request_timeout_ms", "process_admission"],
            "properties": {
              "max_body_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
              "max_context_bytes": {"const": 262144},
              "request_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 20000},
              "process_admission": {"type": "integer", "minimum": 1, "maximum": 4}
            }
          },
          "retention": {"$ref": "#/components/schemas/Retention"}
        }
      },
      "DecisionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol_version", "decision", "state_hash", "question_set", "decision_set", "structural_status", "findings", "replay_available", "replay_bundle", "trace", "retention"],
        "properties": {
          "protocol_version": {"const": "0.2"},
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "question_set": {"type": "object"},
          "decision_set": {"type": "object"},
          "structural_status": {"const": "valid"},
          "findings": {"type": "array", "maxItems": 0},
          "replay_available": {"const": true},
          "replay_bundle": {"type": "object"},
          "trace": {"type": "array", "items": {"$ref": "#/components/schemas/TraceStage"}},
          "retention": {"$ref": "#/components/schemas/Retention"},
          "adapter_metadata": {"$ref": "#/components/schemas/AdapterMetadata"}
        }
      },
      "ReplayResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["replay_status", "structural_status", "findings", "retention", "trace"],
        "properties": {
          "replay_status": {"const": "decision_reproduced"},
          "structural_status": {"enum": ["valid", "invalid"]},
          "findings": {"type": "array", "items": {"$ref": "#/components/schemas/Finding"}},
          "retention": {"$ref": "#/components/schemas/Retention"},
          "trace": {"type": "array", "items": {"$ref": "#/components/schemas/TraceStage"}}
        }
      },
      "Finding": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail"],
        "properties": {
          "code": {"type": "string", "pattern": "^(binding_mismatch|decision_checksum_mismatch|invalid_answers|pack_rebuild|pack_shape|project_binding|snapshot_identity|unknown_adapter|unpinned_adapter|unpinned_question_set|unpinned_verifier|unresolved_model|(answer_type_mismatch|invalid_choice|invalid_noul|invalid_score|missing_answer|unexpected_answer|unsupported_question_type):.+)$"},
          "detail": {"type": "string", "minLength": 1}
        }
      },
      "AdapterMetadata": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "evaluation_time_ms": {"type": "number", "minimum": 0},
          "usage": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "number", "minimum": 0}
          }
        }
      },
      "TraceStage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"enum": ["receive", "decide", "verify", "replay"]},
          "status": {"enum": ["completed", "failed"]}
        }
      },
      "Retention": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server_history", "replay", "idempotency"],
        "properties": {
          "server_history": {"const": false},
          "replay": {"const": "caller_owned"},
          "idempotency": {"const": "none"}
        }
      }
    }
  }
}
