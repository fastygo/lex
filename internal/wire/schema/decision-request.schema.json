{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lex.fastygo.dev/schema/v0.2/decision-request",
  "title": "LeX v0.2 typed decision request",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "decision", "state", "question_set"],
  "properties": {
    "project_id": {"$ref": "#/$defs/id"},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "state": {"type": "object"},
    "question_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "questions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "questions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"},
          "additionalProperties": {"$ref": "#/$defs/question"}
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "snapshot", "pack_request"],
      "properties": {
        "pack": {"type": "object"},
        "snapshot": {"type": "object"},
        "pack_request": {"type": "object"}
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
      "additionalProperties": {"type": "string", "maxLength": 1024}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,255}$"
    },
    "question": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instructions"],
          "properties": {
            "type": {"const": "noul"},
            "instructions": {"type": "string", "minLength": 1, "maxLength": 16384}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instructions", "options"],
          "properties": {
            "type": {"const": "choice"},
            "instructions": {"type": "string", "minLength": 1, "maxLength": 16384},
            "options": {
              "type": "object",
              "minProperties": 2,
              "maxProperties": 255,
              "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"},
              "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 16384}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instructions", "levels"],
          "properties": {
            "type": {"const": "score"},
            "instructions": {"type": "string", "minLength": 1, "maxLength": 16384},
            "levels": {
              "type": "array",
              "minItems": 2,
              "maxItems": 10,
              "items": {"type": "string", "minLength": 1, "maxLength": 16384},
              "uniqueItems": true
            }
          }
        }
      ]
    }
  }
}
